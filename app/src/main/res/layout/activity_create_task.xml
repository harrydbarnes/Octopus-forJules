<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:transitionName="shared_element_container"
    android:background="?android:colorBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="128dp"
            app:expandedTitleMarginStart="16dp"
            app:expandedTitleMarginBottom="20dp"
            app:expandedTitleTextAppearance="?attr/textAppearanceHeadlineMedium"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:elevation="0dp"
                app:layout_collapseMode="pin"
                app:navigationIcon="@drawable/ic_arrow_back"
                app:title="New Task" />
        </com.google.android.material.appbar.CollapsingToolbarLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="visible">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/repoInputLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Repository (Optional)"
                android:layout_marginBottom="16dp"
                app:shapeAppearance="@style/ShapeAppearance.Jules.MediumComponent">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/repoInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:focusable="false"
                    android:clickable="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/branchInputLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Branch (Optional)"
                android:layout_marginBottom="16dp"
                android:visibility="invisible"
                app:shapeAppearance="@style/ShapeAppearance.Jules.MediumComponent">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/branchInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:focusable="false"
                    android:clickable="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchAutoCreatePr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Auto Create PR"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchRequirePlanApproval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Require Plan Approval"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="16dp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/taskInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Describe the task for Jules..."
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/ic_mic"
                    app:endIconContentDescription="Voice Input"
                    app:shapeAppearance="@style/ShapeAppearance.Jules.MediumComponent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/taskInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minLines="3"
                        android:maxLines="3"
                        android:gravity="top" />
                </com.google.android.material.textfield.TextInputLayout>

                <ImageView
                    android:id="@+id/btnExpandTaskInput"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_alignBottom="@id/taskInputLayout"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/ic_arrow_down"
                    android:alpha="0.5" />
            </RelativeLayout>

            <com.google.android.flexbox.FlexboxLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:flexWrap="wrap"
                app:justifyContent="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPromptPerformance"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/prompt_performance_title" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPromptDesign"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/prompt_design_title" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPromptSecurity"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/prompt_security_title" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPromptBugHunt"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/prompt_bug_hunt_title" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPromptUpdateDependencies"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/prompt_update_dependencies_title" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPromptReadme"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/prompt_readme_title" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPromptSimplify"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/prompt_simplify_title" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPromptRefactor"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/prompt_refactor_title" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPromptUnitTests"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/prompt_unit_tests_title" />

            </com.google.android.flexbox.FlexboxLayout>

            <Button
                android:id="@+id/btn_start_task"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Send to Jules"
                android:layout_marginTop="24dp"
                style="@style/Widget.Material3.Button"
                app:cornerRadius="20dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/pageLoadingIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
