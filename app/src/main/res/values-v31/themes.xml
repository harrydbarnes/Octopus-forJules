<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash screen background is black so the adaptive icon (white circle +
         purple octopus) appears centred on a dark screen, matching the app icon. -->
    <style name="Theme.Octopus" parent="Theme.Jules.Base">
        <item name="android:windowSplashScreenBackground">@color/pitch_black</item>
    </style>

    <style name="Theme.Squid" parent="Theme.Jules.Base">
        <item name="android:windowSplashScreenBackground">@color/pitch_black</item>
    </style>
</resources>
